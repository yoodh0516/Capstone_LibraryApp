<?xml version="1.0" encoding="utf-8"?>
<!--
  파일 위치: app/src/main/res/layout/activity_bookmark.xml
  설명: 즐겨찾기 메인 화면. 상단에 '도서관/책' 탭 버튼이 있고, 아래에 리스트가 나옵니다.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 1. 상단 제목 (헤더) -->
    <TextView
        android:id="@+id/tv_bookmark_header"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:text="즐겨찾기"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#000000"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. 네모난 탭 버튼 영역 (도서관 / 책) -->
    <LinearLayout
        android:id="@+id/layout_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_bookmark_header">

        <TextView
            android:id="@+id/tab_library"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="도서관"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#333333"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tab_book"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="책"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#757575"
            android:background="#E0E0E0"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- 3. 즐겨찾기 리스트 (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_bookmarks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/layout_tabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>