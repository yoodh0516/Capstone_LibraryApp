<?xml version="1.0" encoding="utf-8"?>
<!-- ========================================================================== -->
<!-- 인기 도서 화면 UI                                                            -->
<!-- 목적: 메인 화면에서 하단 바를 관리하므로, 여기서는 하단 바(nav_view)를 삭제함         -->
<!-- ========================================================================== -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 1. 상단 제목 (헤더) -->
    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:text="인기 도서 목록"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#000000"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. 도서 리스트 (RecyclerView) -->
    <!-- [수정] Bottom 제약조건을 nav_view가 아닌 parent(화면 맨 밑)로 변경 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_popular_books"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_header_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/seokwon_item_book" />

</androidx.constraintlayout.widget.ConstraintLayout>